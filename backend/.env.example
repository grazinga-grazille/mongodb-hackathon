# MongoDB Atlas — Cluster0 (Sandbox Project)
MONGODB_USER=your_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_HOST=cluster0.geh6kw.mongodb.net
MONGODB_DB=hackathon
MONGODB_APP_NAME=mongodb-hackathon

PORT=3000

# Secret used to hash footprints (address/card/device). Changing it requires a reseed.
FOOTPRINT_SECRET=generate-with-openssl-rand-hex-32

# Embeddings: "local" (no key needed) or "voyage" (set VOYAGE_API_KEY)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# ElevenLabs voice agent (agent id is filled by: npm run agent)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Browser origins allowed to call the API (the frontend). Comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
