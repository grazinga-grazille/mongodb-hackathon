{
  "name": "mongodb-hackathon-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "ping": "node --env-file=.env src/ping.js",
    "setup": "node --env-file=.env src/db/cli.js setup",
    "seed": "node --env-file=.env src/db/cli.js seed",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
